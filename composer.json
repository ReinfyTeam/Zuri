{
    "name": "reinfyteam/zuri",
    "description": "A fast-development, lightweight, and asynchronous powerful anticheat made to destroy hackers and cheaters to your server for PocketMine-MP.",
    "type": "project",
    "require": {
        "paroxity/commando": "dev-master",
        "reinfyteam/discordwebhookapi": "2.0.1",
        "muqsit/simple-packet-handler": "0.1.6",
        "sof3/infoapi": "^2.0.0-beta.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "require-dev": {
        "php": ">=8.2",
        "axolotl-pm/pocketmine-mp": "5.49.1",
        "phpstan/phpstan": "^2.2",
        "sof3/pharynx": "^0.3.8",
        "friendsofphp/php-cs-fixer": "^3.94.2"
    },
    "license": "LGPL-2.1-only",
    "autoload": {
        "psr-4": {
            "ReinfyTeam\\Zuri\\": "src/ReinfyTeam/Zuri/"
        }
    },
	"scripts": {
        "format": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --dry-run --diff",
        "analyze": "phpstan analyse --no-progress",
        "build": [
            "@php tools/prepare-build.php",
            "@php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -p=./build/Zuri.phar",
            "@php tools/verify-build.php"
        ],
        "build-source": [
            "@php tools/prepare-build.php",
            "@php -dphar.readonly=0 vendor/bin/pharynx -i=. -c -o=./build/"
        ],
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
